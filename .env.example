# --- Uçuş verisi (Duffel) ---
# Boş bırakılırsa site örnek veriyle çalışır.
# Test anahtarı "duffel_test_" ile başlar: siparişler Duffel test bakiyesinden ödenir.
# Canlı anahtarla bilet kesimi, ödeme altyapısı (Mollie) bağlanana kadar kapalıdır.
DUFFEL_ACCESS_TOKEN=

# --- Giriş ve Biletlerim (Supabase) ---
# Boş bırakılırsa giriş "örnek mod"da çalışır (e-posta doğrulaması yok, veriler yalnızca tarayıcıda).
# Supabase panelinde: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucuda kullanılır; rezervasyonları veritabanına yazar. Asla tarayıcıya verme.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase'de açtığın sosyal giriş sağlayıcıları (virgülle): google,facebook,apple
# Listede olmayan butonlar görünür ama "henüz açık değil" der.
NEXT_PUBLIC_AUTH_PROVIDERS=

# --- Site adresi ---
# Giriş e-postasındaki bağlantı bu adrese döner (ör. https://pirpir.vercel.app). Boşsa istekteki adres kullanılır.
NEXT_PUBLIC_SITE_URL=
